# Backend
SECRET_KEY=troque-esta-chave
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend
DATABASE_URL=postgres://hubflow:hubflow@localhost:5432/hubflow
EMAIL_HOST=localhost
EMAIL_PORT=1025
DEFAULT_FROM_EMAIL=HubFlow <no-reply@hubflow.local>
FRONTEND_URL=http://localhost:5173
REDIS_URL=redis://localhost:6379/0

# Postgres
POSTGRES_DB=hubflow
POSTGRES_USER=hubflow
POSTGRES_PASSWORD=hubflow

# Frontend
VITE_API_URL=http://localhost:8000

# Armazenamento dos anexos e avatares: local (padrão), s3 (AWS ou compatível) ou cloudinary.
STORAGE_BACKEND=local
# Com s3 em desenvolvimento: docker compose --profile s3 up -d (SeaweedFS S3 em http://localhost:8333).
AWS_STORAGE_BUCKET_NAME=hubflow
AWS_S3_ENDPOINT_URL=http://s3:8333
AWS_ACCESS_KEY_ID=hubflow
AWS_SECRET_ACCESS_KEY=hubflow123
AWS_S3_REGION_NAME=
# Domínio público do bucket (S3 local); vazio = URLs assinadas (AWS).
AWS_S3_CUSTOM_DOMAIN=localhost:8333/hubflow
AWS_S3_URL_PROTOCOL=http:
# Com cloudinary: a URL do painel do Cloudinary (API Environment variable).
CLOUDINARY_URL=

# Login com Google e GitHub (opcional; passo a passo no README). Sem client id/secret, o botão não aparece.
BACKEND_URL=http://localhost:8000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
